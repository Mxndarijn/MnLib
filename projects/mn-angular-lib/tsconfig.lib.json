/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    // ng-packagr maps `mn-angular-lib/<entry>` to each entry point it has already built; the
    // workspace mapping to sources (tsconfig.json) would compile an entry into its dependants.
    "paths": {}
  },
  "include": ["src/**/*.ts", "*/public-api.ts", "*/src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
